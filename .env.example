# Copier en .env (à la racine pour Docker, ou dans server/ pour le développement).
# Générer les secrets : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- Déploiement Docker ---
EZGEDCC_DOMAIN=ezged-cc.mondomaine.fr
POSTGRES_PASSWORD=

# --- Console ---
ADMIN_USER=admin
ADMIN_PASSWORD=
SESSION_SECRET=
ENROLL_KEY=
# Double authentification : npm run totp:new (dans server/) puis coller le secret ici.
ADMIN_TOTP_SECRET=

# En dev uniquement (Docker les définit lui-même)
# PUBLIC_URL=http://localhost:3000
# Publication sous un chemin derrière un proxy partagé (Tailscale Funnel) : BASE_PATH=/ezgedcc
# et PUBLIC_URL avec ce chemin (https://serveur.tailnet.ts.net/ezgedcc).
# BASE_PATH=
# LOG_LEVEL=warn            (défaut : info en production, debug en dev)
# DATABASE_URL=            vide = base embarquée PGlite dans ./data/pglite

OFFLINE_MINUTES=5
RETENTION_DAYS=30

# --- Notifications (optionnelles) ---
# Webhook recevant {"text": "..."} : Slack, Mattermost, workflow Teams…
# Jeton de script TeamViewer en lecture seule (« Ordinateurs et contacts » et « Gestion des appareils ») : les fiches sans nom ni
# client prennent le nom de l'appareil dans le compte TeamViewer. Vide = désactivé.
TEAMVIEWER_API_TOKEN=
# Groupes TeamViewer des serveurs EzGED (séparés par des virgules) : leurs appareils sans agent sont listés
# dans la page « Agents à déployer ». Demande en plus le droit de lecture « Gestion des groupes » sur le jeton.
TEAMVIEWER_GROUPS=EzGED

ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# Mise à jour automatique des agents (1 = activée). La console propose son script agent
# (dossier agent\ du paquet) aux agents plus anciens, qui le vérifient (SHA256) avant de l'installer.
# Attention : la console peut alors faire exécuter du code en SYSTEM sur tout le parc.
# Un agent installé avec -NoAutoUpdate refuse ces mises à jour.
AGENT_AUTO_UPDATE=0
